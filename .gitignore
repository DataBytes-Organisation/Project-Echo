# =============================================================================
# .gitignore — Project Echo
# Grouped by category. Patterns are unchanged in behaviour; only reorganised.
# =============================================================================

# -----------------------------------------------------------------------------
# Operating system / editor & IDE files
# -----------------------------------------------------------------------------
*.DS_Store
.directory
.vscode/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
*.pyc
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.coverage
*.egg-info/
build/
dist/

# -----------------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------------
venv/
.venv/

# -----------------------------------------------------------------------------
# Node.js
# -----------------------------------------------------------------------------
node_modules/

# -----------------------------------------------------------------------------
# Environment / secrets (keep example templates tracked)
# -----------------------------------------------------------------------------
*.env
.env.*
!.env.example
!.env_example

# -----------------------------------------------------------------------------
# Logs & experiment tracking
# -----------------------------------------------------------------------------
*.log
logs/
tensorboard_logs/

# MLflow experiment tracking runs
# mlruns/

# -----------------------------------------------------------------------------
# Model weights & large binaries (tracked via DVC instead of git)
# -----------------------------------------------------------------------------
*.hdf5
*.pb
*.index
#models/
# Engine model weights (large binaries)
#src/production/engine/models/*

# -----------------------------------------------------------------------------
# PyTorch training pipeline (src/prototypes/engine/reproducible_training_pipeline/)
# -----------------------------------------------------------------------------
*.pth
*.onnx
src/prototypes/engine/reproducible_training_pipeline/outputs/
src/prototypes/engine/reproducible_training_pipeline/.cache/

# -----------------------------------------------------------------------------
# Local prototype datasets (not tracked, too large / personal-machine paths)
# -----------------------------------------------------------------------------
src/prototypes/data_files/
src/prototypes/spectrograms/

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
*.db

# -----------------------------------------------------------------------------
# Transient / misc
# -----------------------------------------------------------------------------
*.tmp.driveupload

# -----------------------------------------------------------------------------
# Project-specific local / generated data (kept locally, not tracked by git)
# -----------------------------------------------------------------------------
# Uploaded test audio files
uploads/

# Audio recordings from IoT nodes
src/production/iot/management_application/audioLocal
src/production/iot/management_application/audioUpload

# Environment-specific generated file
src/production/backend/app/main.py

# Generated on every `import app.main` (app/main.py's export_openapi_to_file()
# runs unconditionally at module import time, including from tests) - not
# something to commit.
/backend/project-echo-openapi.json

# Benchmarking self-test throwaway output
results_selftest/
dataset/
dataset_v2/

# Generated TFLite quantisation variants (large, reproducible via
# quantise_efficientnetv2.py)
src/prototypes/engine/benchmarking/results_efficientnet/variants/

.claude/
CLAUDE.md
