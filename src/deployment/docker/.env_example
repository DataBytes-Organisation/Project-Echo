# === Rename .env_example to .env before building the project ===
# === Stripe Payment Gateway ===
STRIPE_PRIVATE_KEY=sk_test_your_stripe_key_here

# === MongoDB  Connection ===
# Replace mongodb+srv://<username>:<password>@<cluster>.mongodb.net/echoDB with "mongodb://modelUser:EchoNetAccess2023@ts-mongodb-cont:27017/EchoNet"
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/echoDB

# === Engine <-> Backend service auth ===
# Shared secret: Engine sends it as the X-Engine-Api-Key header on POST /engine/event,
# Backend validates it. Passed into both the echo_engine and echo_api containers.
# Leave unset/empty to leave that endpoint unauthenticated (e.g. local/dev).
ENGINE_API_KEY=

# Please go through "Environment Setup & Stripe Integration Guide" uploaded in the Project Echo team files.

# RQ background jobs (C1). HMI JWT stays on Redis DB 0; jobs use DB 1.
# Queue name: echo-backend. Enqueued jobs use job_timeout=60 and Retry max=3
# with intervals 10s, 30s, 60s.
REDIS_URL=redis://echo-redis:6379/1
# Optional outbound URL for the post-persistence detection webhook job.
# Leave empty to skip HTTP dispatch (job returns False, no FailedJobRegistry).
DETECTION_WEBHOOK_URL=