# === Rename .env_example to .env before building the project ===
# === Stripe Payment Gateway ===
STRIPE_PRIVATE_KEY=sk_test_your_stripe_key_here

# Database Config
# Replace all <placeholders> below with the appropriate credentials and configuration values before running the project.
MONGODB_URI=mongodb://<username>:<password>@<mongo_host>:<mongo_port>/<database_name>
USER_MONGODB_URI=mongodb://<username>:<password>@<mongo_host>:<mongo_port>/<database_name>?authSource=<auth_database>
# Optional, defaults to "EchoNet" if unset
MONGO_DB=EchoNet

#API_Config
PORT=9000
NODE_ENV=development

# Auth (required — the API will fail to start without this)
JWT_SECRET=change_me_to_a_long_random_secret

# Twilio Configuration (optional — SMS/2FA is skipped if unset)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here  # in E.164 format e.g., +61412345678

# Mail Configuration (optional, used by /sim email notifications)
MAIL_USERNAME=your_gmail_address_here
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM=your_gmail_address_here

# --- The following are optional; sensible defaults are baked into
# --- app/config.py and match the docker-compose service/container names.
# REDIS_HOST=echo-redis
# REDIS_PORT=6379
# MQTT_HOST=ts-mqtt-server-cont
# MQTT_PORT=1883
# MQTT_ENGINE_TOPIC=projectecho/engine/2
# MQTT_DETECTION_TOPIC=projectecho/detections
# INTERNAL_API_BASE_URL=http://ts-api-cont:9000
# API_PORT=9000
# REQUEST_TIMEOUT_SECONDS=15
# SLOW_OPERATION_MS=500
# CACHE_TTL_SECONDS=60
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_SECONDS=86400
# OTP_EXPIRY_MINUTES=5
# LOG_LEVEL=INFO
# CORS_ORIGINS=["*"]
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_STARTTLS=true
# MAIL_USE_SSL=false