{
  "model": {
    "tflite_path": "../../../../production/engine/models/efficientnetv2/efficientnetv2_project_echo.tflite",
    "class_mapping_path": "../../../../production/engine/models/efficientnetv2/class_mapping.json",
    "preprocess_config_path": "../../../../production/engine/models/efficientnetv2/preprocess_config.json"
  },
  "dataset_sources": [
    {
      "bucket": "project_echo_bucket_3",
      "description": "Combined segmented Project Echo dataset for the 118 scientific-name classes"
    },
    {
      "bucket": "project_echo_birdclef",
      "description": "BirdCLEF source for brant, jabwar, sheowl, spodov and wiltur"
    }
  ],
  "selection": {
    "files_per_species": 10,
    "reserve_files_per_species": 5,
    "original_test_size": 0.2,
    "original_split_random_state": 42,
    "selection_seed": 20260807,
    "valid_extensions": [".flac", ".mp3", ".ogg", ".wav"],
    "augmentation_markers": [
      "augmented",
      "add_gaussian_snr",
      "background_noise",
      "short_noises",
      "padding",
      "specaugment",
      "time_mask",
      "time_stretch",
      "pitch_shift",
      "_aug_"
    ]
  },
  "reporting": {
    "poor_species_recall_threshold": 0.9,
    "top_k": [1, 3, 5]
  }
}
