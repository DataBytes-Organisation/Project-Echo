# Database Config (required — the API will fail to start without these)
MONGODB_URI=mongodb://<username>:<password>@<mongo_host>:<mongo_port>/<database_name>
USER_MONGODB_URI=mongodb://<username>:<password>@<mongo_host>:<mongo_port>/<database_name>?authSource=<auth_database>

# Auth (required — the API will fail to start without this)
JWT_SECRET=change_me_to_a_long_random_secret

# Twilio Configuration (optional — SMS/2FA is skipped if unset)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here  # in E.164 format e.g., +61412345678

# API rate limiting (per API container/client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=3
RATE_LIMIT_WINDOW_SECONDS=60
# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY=false
# Mail Configuration (optional, used by /sim email notifications)
MAIL_USERNAME=your_gmail_address_here
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM=your_gmail_address_here

# --- Detection rule engine (A3, optional) ---
# Applied to every incoming detection (app.detection_rules.evaluate_detection)
# before it's persisted, via app.detections.create_detection. Change these
# values and restart the API - no route code needs editing. Leaving a value
# unset/empty means "no restriction" for that rule.
# DETECTION_MIN_CONFIDENCE=80
# DETECTION_ALLOWED_SPECIES=Koala,Sus Scrofa
# DETECTION_ALLOWED_SENSOR_IDS=1,2

# Cloudflare R2 object storage (optional; required when R2 storage is used)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Existing prototype dataset prefix override
R2_DATASET_PREFIX=prototype

# --- Docker/Kubernetes secret files (C5, optional) ---
# Sensitive settings such as MONGODB_URI, USER_MONGODB_URI, JWT_SECRET,
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, MAIL_PASSWORD,
# R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY can instead be supplied by
# mounting them as a secret file and pointing to it with a "<NAME>_FILE"
# variable, e.g.:
#   JWT_SECRET_FILE=/run/secrets/jwt_secret
# When both "<NAME>_FILE" and "<NAME>" are set, the file wins.

# See src/deployment/docker/.env_example for the full list of optional
# infra overrides (Redis/MQTT/timeouts/etc.) with their defaults.
# Razorpay credentials used only by the Backend payment contract.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shared secret the Engine service sends as the X-Engine-Api-Key header on
# POST /engine/event. Leave unset to leave that endpoint unauthenticated
# (e.g. local/dev).
ENGINE_API_KEY=

# C12 Backend feature flags
# Set to false to disable the corresponding Sprint 2 behaviour.
REALTIME_STREAMING_ENABLED=true
ANALYTICS_EXTENSIONS_ENABLED=true
