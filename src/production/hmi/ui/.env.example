# API host for the backend service.
# For local development, use 'localhost'.
# In Kubernetes, this is set automatically via the hmi-env ConfigMap to 'api-service'.
API_HOST=localhost

# Backend API port.
API_PORT=9000

# Base URL for the frontend client, used for redirects and email links.
# For local development, use 'http://localhost:3000'.
# On the live server, this should be set to the public URL of the site.
CLIENT_URL=http://localhost:3000

# Signs the per-request browser session cookie. Use a long, random value.
COOKIE_SECRET=
